<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/nougat.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Nougat</RootNamespace>
    <AssemblyName>Nougat</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <None Update="nlog.config" CopyToOutputDirectory="PreserveNewest" />
    <!-- Kein Strings.Designer.cs: Der ResX-Generator laeuft nur unter Visual
         Studio zuverlaessig. Der LocalizationService greift direkt per
         ResourceManager zu, dafuer reicht das eingebettete EmbeddedResource. -->
    <EmbeddedResource Update="Localization/Strings.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Localization/Strings.de.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <InternalsVisibleTo Include="Nougat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- Tray unter Linux: Avalonia zieht Tmds.DBus.Protocol transitiv, aber ein
         PackageVersion ohne PackageReference pinnt NICHTS. Explizit referenzieren,
         sonst gilt die Version aus Directory.Packages.props gar nicht. -->
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="NLog" />
    <PackageReference Include="NLog.Extensions.Logging" />
    <PackageReference Include="Semver" />
  </ItemGroup>

  <!-- DevTools nur im Debug-Build -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
  </ItemGroup>
</Project>
