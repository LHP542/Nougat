<chrome:ChromeWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:loc="using:Nougat.Localization"
                     xmlns:chrome="using:Nougat.Chrome"
                     xmlns:ctrl="using:Nougat.Controls"
                     x:Class="Nougat.Views.ErrorWindow"
                     Title="{loc:Tr Error_Title}"
                     Width="640" Height="440"
                     MinWidth="480" MinHeight="320"
                     WindowStartupLocation="CenterOwner"
                     Background="{DynamicResource KrosteBackgroundBrush}">
    <DockPanel>
        <ctrl:TitleBar DockPanel.Dock="Top" Title="{loc:Tr Error_Title}" />

        <Border DockPanel.Dock="Bottom" Classes="statusbar">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="ghost" Content="{loc:Tr Error_CopyDetails}" Click="OnCopyClick" />
                <Button Classes="ghost" Content="{loc:Tr Error_OpenLog}" Click="OnOpenLogClick" />
                <Button Classes="accent" Content="{loc:Tr Error_Continue}" Click="OnCloseClick" />
            </StackPanel>
        </Border>

        <StackPanel Margin="24,20" Spacing="12">
            <TextBlock Classes="h1" Text="{loc:Tr Error_Heading}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap"
                       Text="{loc:Tr Error_Intro}" />

            <TextBlock x:Name="MessageText" Classes="section-label" TextWrapping="Wrap" />

            <Border Classes="card-flat" Height="200">
                <ScrollViewer>
                    <SelectableTextBlock x:Name="DetailText"
                                         Margin="12"
                                         FontFamily="monospace" FontSize="11"
                                         TextWrapping="NoWrap"
                                         Foreground="{DynamicResource KrosteMutedTextBrush}" />
                </ScrollViewer>
            </Border>
        </StackPanel>
    </DockPanel>
</chrome:ChromeWindow>
