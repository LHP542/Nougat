<chrome:ChromeWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:loc="using:Nougat.Localization"
                     xmlns:chrome="using:Nougat.Chrome"
                     xmlns:ctrl="using:Nougat.Controls"
                     xmlns:vm="using:Nougat.ViewModels"
                     x:Class="Nougat.Views.InfoWindow"
                     x:DataType="vm:InfoWindowViewModel"
                     Title="{loc:Tr Info_Title}"
                     Width="560" Height="520"
                     MinWidth="460" MinHeight="420"
                     WindowStartupLocation="CenterOwner"
                     Background="{DynamicResource KrosteBackgroundBrush}">
    <DockPanel>
        <ctrl:TitleBar DockPanel.Dock="Top" Title="{loc:Tr Info_Title}" />

        <Border DockPanel.Dock="Bottom" Classes="statusbar">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="ghost" Content="{loc:Tr Info_GitHub}" Click="OnGithubClick" />
                <Button Classes="coffee" Content="{loc:Tr Info_Coffee}" Click="OnCoffeeClick" />
                <Button Classes="accent" Content="{loc:Tr Common_Close}" Click="OnCloseClick" />
            </StackPanel>
        </Border>

        <StackPanel Margin="24,20" Spacing="14">
            <StackPanel Spacing="3">
                <TextBlock Classes="h1" FontSize="28" Text="Nougat" />
                <TextBlock Classes="muted" Text="{Binding Version}" />
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="{loc:Tr Info_SectionPublisher}" />
                    <TextBlock Classes="h2" FontSize="13" Text="{Binding Organisation}" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Tr Info_Description}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="section-label" Text="{loc:Tr Info_SectionUpdates}" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Classes="secondary" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Text="{Binding UpdateStatus}" />
                        <Button Grid.Column="1" Classes="ghost" Content="{loc:Tr Info_CheckUpdate}"
                                Command="{Binding CheckUpdateCommand}" />
                        <Button Grid.Column="2" Classes="accent" Content="{loc:Tr Info_InstallUpdate}"
                                Command="{Binding InstallUpdateCommand}"
                                IsVisible="{Binding UpdateAvailable}" />
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding DownloadProgress}"
                                 IsVisible="{Binding IsDownloading}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</chrome:ChromeWindow>
