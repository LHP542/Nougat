<chrome:ChromeWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:chrome="using:Nougat.Chrome"
                     xmlns:ctrl="using:Nougat.Controls"
                     xmlns:vm="using:Nougat.ViewModels"
                     x:Class="Nougat.Views.InfoWindow"
                     x:DataType="vm:InfoWindowViewModel"
                     Title="Ueber Nougat"
                     Width="520" Height="380"
                     MinWidth="440" MinHeight="320"
                     WindowStartupLocation="CenterOwner"
                     Background="{DynamicResource KrosteBackgroundBrush}">
    <DockPanel>
        <ctrl:TitleBar DockPanel.Dock="Top" Title="Ueber Nougat" />

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource KrosteTitleBarBrush}"
                Padding="12,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="GitHub" Click="OnGithubClick"
                        Background="{DynamicResource KrosteAccentBrush}"
                        Foreground="White" Padding="14,6" />
                <Button Content="Buy me a coffee" Click="OnCoffeeClick"
                        Background="#FFDD00" Foreground="Black"
                        FontWeight="SemiBold" Padding="14,6" />
                <Button Content="Schliessen" Click="OnCloseClick" Padding="14,6" />
            </StackPanel>
        </Border>

        <StackPanel Margin="28,20" Spacing="14">
            <TextBlock Text="Nougat"
                       FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource KrosteGoldBrush}" />
            <TextBlock Text="{Binding Version}"
                       Foreground="{DynamicResource KrosteMutedBrush}" />
            <TextBlock Text="{Binding Organisation}"
                       Foreground="White" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Description}"
                       Foreground="White" TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</chrome:ChromeWindow>
