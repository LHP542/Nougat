<chrome:ChromeWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:chrome="using:Nougat.Chrome"
                     xmlns:ctrl="using:Nougat.Controls"
                     xmlns:vm="using:Nougat.ViewModels"
                     xmlns:models="using:Nougat.Models"
                     mc:Ignorable="d"
                     x:Class="Nougat.Views.MainWindow"
                     x:DataType="vm:MainWindowViewModel"
                     Title="Nougat"
                     Width="1100" Height="720"
                     MinWidth="880" MinHeight="560"
                     Background="{DynamicResource KrosteBackgroundBrush}">

    <DockPanel>
        <!-- Titelleiste -->
        <ctrl:TitleBar DockPanel.Dock="Top" Title="{Binding Title}" />

        <!-- Menüleiste -->
        <Border DockPanel.Dock="Top" Classes="header">
            <StackPanel Orientation="Horizontal" Margin="8,0">
                <Button Classes="menu" Content="Einstellungen" Click="OnSettingsClick" />
                <Button Classes="menu" Content=".NET SDK installieren" Click="OnInstallSdkClick" />
                <Button Classes="menu" Content="Über" Click="OnAboutClick" />
            </StackPanel>
        </Border>

        <!-- Fußleiste: Zielordner + Primäraktionen -->
        <Border DockPanel.Dock="Bottom" Classes="statusbar">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="3">
                    <TextBlock Classes="section-label" Text="ZIELORDNER" Margin="0" />
                    <TextBox Text="{Binding OutputDirectory, Mode=TwoWay}"
                             MinWidth="380" MaxWidth="620"
                             HorizontalAlignment="Left" />
                </StackPanel>
                <Button Grid.Column="1" Classes="danger" Content="Abbrechen"
                        Command="{Binding CancelBuildCommand}"
                        VerticalAlignment="Bottom" />
                <Button Grid.Column="2" Classes="accent" Content="Bundle bauen"
                        Command="{Binding BuildBundleCommand}"
                        MinWidth="160" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <!-- Fortschritt -->
        <Border DockPanel.Dock="Bottom" Padding="14,6,14,10">
            <StackPanel Orientation="Vertical" Spacing="5">
                <TextBlock Classes="secondary" Text="{Binding StatusText}" />
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" />
            </StackPanel>
        </Border>

        <!-- Hauptbereich: links Repos, rechts Log -->
        <Grid ColumnDefinitions="320,*" Margin="14,12,14,4" ColumnSpacing="12">
            <!-- Repo-Liste -->
            <Border Grid.Column="0" Classes="card-flat">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12,14,4" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="h2" Text="Repositories"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost" Content="Aktualisieren"
                                Command="{Binding RefreshReposCommand}"
                                Padding="10,4" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Classes="muted"
                               Text="{Binding RepoListStatus}"
                               FontSize="11" Margin="14,0,14,8" />

                    <Border DockPanel.Dock="Bottom" Classes="header"
                            BorderThickness="0,1,0,0" Padding="14,8">
                        <TextBlock Classes="h2" FontSize="12"
                                   Text="{Binding SelectedCount, StringFormat={}{0} ausgewählt}" />
                    </Border>

                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Repos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RepoItemViewModel">
                                    <Border Padding="14,5" Background="Transparent">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource KrosteTextBrush}" />
                                                <TextBlock Classes="muted"
                                                           Text="{Binding Description}"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="230" />
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Log-Panel -->
            <Border Grid.Column="1" Classes="card-flat">
                <DockPanel Margin="14,12">
                    <TextBlock DockPanel.Dock="Top" Classes="h2" Text="Log" Margin="0,0,0,8" />
                    <ScrollViewer x:Name="LogScroll" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:LogEntry">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="log muted"
                                                   Text="{Binding Timestamp, StringFormat=HH:mm:ss}" />
                                        <TextBlock Classes="log"
                                                   Text="{Binding Severity}"
                                                   MinWidth="46"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                        <TextBlock Classes="log"
                                                   Text="{Binding Message}"
                                                   Foreground="{DynamicResource KrosteTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</chrome:ChromeWindow>
