<chrome:ChromeWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:chrome="using:Nougat.Chrome"
                     xmlns:ctrl="using:Nougat.Controls"
                     xmlns:vm="using:Nougat.ViewModels"
                     x:Class="Nougat.Views.SdkInstallWindow"
                     x:DataType="vm:SdkInstallViewModel"
                     Title=".NET SDK installieren"
                     Width="620" Height="520"
                     MinWidth="500" MinHeight="380"
                     WindowStartupLocation="CenterOwner"
                     Background="{DynamicResource KrosteBackgroundBrush}">
    <DockPanel>
        <ctrl:TitleBar DockPanel.Dock="Top" Title=".NET SDK installieren" />

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource KrosteTitleBarBrush}"
                Padding="12,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Abbrechen" Command="{Binding CancelCommand}"
                        IsEnabled="{Binding IsInstalling}" Padding="14,6" />
                <Button Content="Jetzt installieren" Command="{Binding InstallCommand}"
                        IsEnabled="{Binding !IsInstalling}" Classes="accent" MinWidth="160" />
            </StackPanel>
        </Border>

        <StackPanel Margin="24,16" Spacing="10">
            <TextBlock Text="Zum Bau des Bundles wird .NET 10 SDK benötigt."
                       Foreground="White" TextWrapping="Wrap" />
            <TextBlock Text="Es wird nach ~/.dotnet-nougat installiert (ca. 400 MB). Keine Systemänderungen, kein sudo."
                       Foreground="{DynamicResource KrosteMutedBrush}" TextWrapping="Wrap" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="8" />
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource KrosteGoldBrush}" />
            <Border BorderBrush="#22262B" BorderThickness="1" Height="260">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding LogLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Cascadia Code, Consolas, monospace"
                                           FontSize="11"
                                           Foreground="White"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </DockPanel>
</chrome:ChromeWindow>
