<chrome:ChromeWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:loc="using:Nougat.Localization"
                     xmlns:chrome="using:Nougat.Chrome"
                     xmlns:ctrl="using:Nougat.Controls"
                     xmlns:vm="using:Nougat.ViewModels"
                     x:Class="Nougat.Views.SettingsWindow"
                     x:DataType="vm:SettingsWindowViewModel"
                     Title="{loc:Tr Settings_Title}"
                     Width="660" Height="620"
                     MinWidth="520" MinHeight="440"
                     WindowStartupLocation="CenterOwner"
                     Background="{DynamicResource KrosteBackgroundBrush}">
    <DockPanel>
        <ctrl:TitleBar DockPanel.Dock="Top" Title="{loc:Tr Settings_Title}" />

        <Border DockPanel.Dock="Bottom" Classes="statusbar">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="ghost" Content="{loc:Tr Common_Cancel}" Command="{Binding CancelCommand}" />
                <Button Classes="accent" Content="{loc:Tr Common_Save}" Command="{Binding SaveCommand}" MinWidth="120" />
            </StackPanel>
        </Border>

        <ScrollViewer Padding="20,16">
            <StackPanel Spacing="12">
                <StackPanel Spacing="3">
                    <TextBlock Classes="h1" Text="{loc:Tr Settings_Title}" />
                    <TextBlock Classes="muted" Text="{loc:Tr Settings_Subtitle}" />
                </StackPanel>

                <!-- Sprache: bewusst ganz oben, weil der Rest des Fensters davon abhaengt -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="section-label" Text="{loc:Tr Settings_SectionLanguage}" />
                        <TextBlock Classes="h2" Text="{loc:Tr Settings_Language}" />
                        <ComboBox ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  HorizontalAlignment="Left" MinWidth="220">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LanguageChoice">
                                    <TextBlock Text="{Binding Display}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Zugang -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="section-label" Text="{loc:Tr Settings_SectionGithub}" />
                        <TextBlock Classes="h2" Text="{loc:Tr Settings_Pat}" />
                        <TextBox Text="{Binding Pat, Mode=TwoWay}"
                                 PasswordChar="*"
                                 PlaceholderText="ghp_..." />
                        <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="11"
                                   Text="{loc:Tr Settings_PatHint}" />
                    </StackPanel>
                </Border>

                <!-- Pfade -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="section-label" Text="{loc:Tr Settings_SectionPaths}" />
                        <TextBlock Classes="h2" Text="{loc:Tr Settings_OutputDir}" />
                        <TextBox Text="{Binding OutputDirectory, Mode=TwoWay}" />
                        <TextBlock Classes="h2" Text="{loc:Tr Settings_WorkDir}" Margin="0,6,0,0" />
                        <TextBox Text="{Binding WorkDirectory, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- Restore -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="section-label" Text="{loc:Tr Settings_SectionRestore}" />
                        <TextBlock Classes="h2" Text="{loc:Tr Settings_Rids}" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Content="win-x64" IsChecked="{Binding RidWinX64, Mode=TwoWay}" />
                            <CheckBox Content="linux-x64" IsChecked="{Binding RidLinuxX64, Mode=TwoWay}" />
                            <CheckBox Content="osx-x64" IsChecked="{Binding RidOsxX64, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Repo-Liste -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="section-label" Text="{loc:Tr Settings_SectionRepoList}" />
                        <TextBlock Classes="h2" Text="{loc:Tr Settings_CacheTtl}" />
                        <NumericUpDown Value="{Binding RepoCacheTtlHours, Mode=TwoWay}"
                                       Minimum="1" Maximum="168" Increment="1"
                                       FormatString="0" HorizontalAlignment="Left" MinWidth="160" />
                        <CheckBox Content="{loc:Tr Settings_ShowArchived}"
                                  IsChecked="{Binding ShowArchivedRepos, Mode=TwoWay}"
                                  Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</chrome:ChromeWindow>
