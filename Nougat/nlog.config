<?xml version="1.0" encoding="utf-8"?>
<!-- Kroste-Standard: So viel wie möglich loggen. Datei = Trace aufwärts,
     Konsole = Info aufwärts. Secrets werden über den masked-Layout-Renderer
     maskiert (MaskingLayoutRenderer wird im Programmstart registriert). -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="logs/nlog-internal.log">

  <targets>
    <target xsi:type="File" name="file"
            fileName="logs/nougat.log"
            archiveFileName="logs/archive/nougat.{#}.log"
            archiveEvery="Day"
            maxArchiveFiles="14"
            layout="${longdate}|${level:uppercase=true}|${logger}|${masked:inner=${message}}${onexception:inner=|${exception:format=tostring}}" />

    <target xsi:type="ColoredConsole" name="console"
            layout="${time}|${level:uppercase=true}|${logger:shortName=true}|${masked:inner=${message}}${onexception:inner=|${exception:format=message}}" />
  </targets>

  <rules>
    <!-- HttpClient-Rauschen filtern: Microsoft.Extensions.Http schreibt pro
         Request vier Zeilen ("Start processing" / "Sending" / "Received" /
         "End processing") - und zwar auf INFO, nicht auf Debug. Der frühere
         maxlevel="Debug" hat davon nichts geschluckt; jeder Request stand
         vollständig im Log. maxlevel="Info" + final schneidet alles bis Info
         weg und lässt Warn/Error an die allgemeinen Regeln weiterlaufen.
         Die zweite Regel von früher ("minlevel=Warn writeTo=...") war doppelt
         zur '*'-Regel unten und wurde von NLog mit einer Warnung im
         nlog-internal.log verworfen - deshalb ist sie ersatzlos raus. -->
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <logger name="*" minlevel="Trace" writeTo="file" />
    <logger name="*" minlevel="Info" writeTo="console" />
  </rules>
</nlog>
